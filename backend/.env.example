# Application
APP_NAME=Real Estate Booking System
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# CORS — comma-separated explicit origins (no wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (used for Stripe redirects / docs)
FRONTEND_URL=http://localhost:3000

# MySQL
DB_USER=root
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=3306
DB_NAME=realestate_db
# Optional full URL override (takes precedence over DB_*):
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/realestate_db

# Google Identity Services — OAuth 2.0 Web Client ID (same as frontend REACT_APP_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Maps (optional; geocoding falls back if unset)
GOOGLE_MAPS_API_KEY=

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Booking policy
BOOKING_REQUEST_EXPIRE_HOURS=48
BOOKING_PAYMENT_EXPIRE_HOURS=24
DEFAULT_DEPOSIT_PERCENT=0.10
